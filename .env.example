# Address the HTTP server binds to.
TG_MCP_BIND=0.0.0.0:8080
# Public base URL clients reach the server at. OAuth metadata and Host-header validation derive from it.
TG_MCP_PUBLIC_URL=http://localhost:8080
# Development only: fake Telegram (every login is the same fake Account, no network).
# Leave unset in production.
TG_MCP_FAKE_TELEGRAM=1
# SQLite database file of the Session vault (Grants, Tokens, sealed Telegram sessions). Created if missing.
TG_MCP_DB_PATH=./tg-mcp.db
# Telegram app credentials from https://my.telegram.org/apps. Required unless TG_MCP_FAKE_TELEGRAM=1.
TG_MCP_API_ID=
TG_MCP_API_HASH=
# Seconds an unused Live client (connection to Telegram) stays open. Default 600.
TG_MCP_LIVE_CLIENT_IDLE_SECS=600
# Per-Account budget for requests to Telegram: sustained rate and burst. Defaults 60 and 20.
TG_MCP_ACCOUNT_REQUESTS_PER_MINUTE=60
TG_MCP_ACCOUNT_BURST=20
# Waits (budget queue or Telegram's FLOOD_WAIT) up to this many seconds are slept
# through inside a tool call; longer ones fail with "retry in N s". Default 10.
TG_MCP_MAX_WAIT_SECS=10
# Log filter (tracing EnvFilter syntax). rmcp is capped at info so JSON-RPC payloads never reach the log.
RUST_LOG=info
