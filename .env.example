# Address the HTTP server binds to.
TG_MCP_BIND=0.0.0.0:8080
# Public base URL clients reach the server at. OAuth metadata and Host-header validation derive from it.
TG_MCP_PUBLIC_URL=http://localhost:8080
# Development only: fake Telegram (every login is the same fake Account, no network).
# Leave unset in production.
TG_MCP_FAKE_TELEGRAM=1
# SQLite database file of the Session vault (Grants, Tokens, sealed Telegram sessions). Created if missing.
TG_MCP_DB_PATH=./tg-mcp.db
# Telegram app credentials from https://my.telegram.org/apps. Required unless TG_MCP_FAKE_TELEGRAM=1.
TG_MCP_API_ID=
TG_MCP_API_HASH=
# Seconds an unused Live client (connection to Telegram) stays open. Default 600.
TG_MCP_LIVE_CLIENT_IDLE_SECS=600
# Per-Account budget for requests to Telegram: sustained rate and burst. Defaults 60 and 20.
TG_MCP_ACCOUNT_REQUESTS_PER_MINUTE=60
TG_MCP_ACCOUNT_BURST=20
# Waits (budget queue or Telegram's FLOOD_WAIT) up to this many seconds are slept
# through inside a tool call; longer ones fail with "retry in N s". Default 10.
TG_MCP_MAX_WAIT_SECS=10
# Take the client IP for the limits below from the right-most X-Forwarded-For entry.
# Set to 1 only behind a reverse proxy that always sets or appends X-Forwarded-For
# from its own TCP peer (kamal-proxy does); otherwise clients could pick their IP.
# Unset or 0: the TCP peer address is the client.
TG_MCP_TRUST_FORWARDED_FOR=0
# Per-client-IP limits on the anonymous endpoints (token buckets: sustained
# rate per minute and burst). Over the limit: 429 Too Many Requests + Retry-After.
# /authorize: defaults 10 and 5.
TG_MCP_AUTHORIZE_PER_MINUTE=10
TG_MCP_AUTHORIZE_BURST=5
# /register: defaults 5 and 5.
TG_MCP_REGISTER_PER_MINUTE=5
TG_MCP_REGISTER_BURST=5
# /token and /revoke (one bucket each): defaults 30 and 10.
TG_MCP_TOKEN_PER_MINUTE=30
TG_MCP_TOKEN_BURST=10
# /media/{ticket} (Media link downloads; unknown tickets count too): defaults 30 and 10.
TG_MCP_MEDIA_PER_MINUTE=30
TG_MCP_MEDIA_BURST=10
# Login flows in progress at once (each holds a Telegram connection for up to 10 min),
# server-wide and per client IP. When full, /authorize answers temporarily_unavailable.
# Defaults 50 and 3.
TG_MCP_MAX_PENDING_LOGINS=50
TG_MCP_MAX_PENDING_LOGINS_PER_IP=3
# EXPERIMENTAL, off by default (#58 prototype): 1 lets get_media take mode `document`
# (a PDF or plain-text file of up to 5 MB as an embedded resource in the tool result).
# Unset or 0: the mode is neither taken nor listed. It may change or go away.
TG_MCP_EXPERIMENTAL_DOCUMENTS=0
# Log filter (tracing EnvFilter syntax). rmcp is capped at info so JSON-RPC payloads never reach the log.
RUST_LOG=info
