# Address the HTTP server binds to.
TG_MCP_BIND=0.0.0.0:8080
# Public base URL clients reach the server at. OAuth metadata and Host-header validation derive from it.
TG_MCP_PUBLIC_URL=http://localhost:8080
# Development only: serve a fixed fake Telegram account instead of logging in. Required until real login lands (#5).
TG_MCP_FAKE_TELEGRAM=1
# Log filter (tracing EnvFilter syntax). rmcp is capped at info so JSON-RPC payloads never reach the log.
RUST_LOG=info
